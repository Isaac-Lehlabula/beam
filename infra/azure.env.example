# Copy to infra/azure.env (git-ignored) and fill in. Read by infra/deploy.ps1.
# Format: KEY=value, one per line, no quotes.

# ---- Azure ----
AZURE_RESOURCE_GROUP=beam-rg
AZURE_LOCATION=westeurope
# Optional: Postgres region if Burstable B1ms isn't available in AZURE_LOCATION.
POSTGRES_LOCATION=
# Optional: resource name prefix (lowercase letters/digits/hyphens).
PREFIX=beam

# ---- Postgres (created by the deploy) ----
# 12+ chars, upper/lower/digit. Avoid ; and ' (it goes into a connection string).
POSTGRES_ADMIN_PASSWORD=

# ---- Supabase Storage (Dashboard -> Storage -> S3 Connection / Access keys) ----
STORAGE_SERVICE_URL=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=<project region, e.g. eu-central-1>
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=beam-assets

# ---- Build ----
# Required: Release builds of the API fail without a SixLabors (ImageSharp) license key.
SIXLABORS_LICENSE_KEY=

# ---- Optional integrations (leave empty to disable) ----
ANTHROPIC_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Scaling ----
# 0 = web app scales to zero when idle (cheaper; slower first load). 1 = always on.
WEB_MIN_REPLICAS=0
